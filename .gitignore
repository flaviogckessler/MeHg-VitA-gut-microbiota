# R session and user files
.Rhistory
.RData
.Ruserdata
.Rproj.user/
.Renviron
.Renviron.*
!.Renviron.example

# R package and report caches
renv/library/
renv/staging/
renv/local/
*_cache/
*_files/
.quarto/

# Raw sequencing reads
*.fastq
*.fastq.gz
*.fq
*.fq.gz

# External reference data
data/external/*
!data/external/.gitkeep
!data/external/README.md

# Full DADA2 reruns are review artifacts, not archived inputs
data/processed/*/dada2_rerun/

# Generated TIFF files are not permitted
figures/**/output/*_generated.tif
figures/**/output/*_generated.tiff
supplementary_figures/**/output/*_generated.tif
supplementary_figures/**/output/*_generated.tiff

# Local validator code (retained in the working tree, not versioned for now)
**/validate_*.R
**/validate_*.py
**/validate_*.ps1
figures/Workflow/tests/
figures/Workflow/workflow_spec_lib.R
figures/Workflow/.staging/

# Temporary and log files
*.tmp
*.temp
*.bak
*.log
*~

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
